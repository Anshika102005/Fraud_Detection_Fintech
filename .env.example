# Database
POSTGRES_USER=fraud
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=fraud_db
DATABASE_URL=postgresql://fraud:change_me_in_production@postgres:5432/fraud_db
ASYNC_DATABASE_URL=postgresql+asyncpg://fraud:change_me_in_production@postgres:5432/fraud_db

# Redis
REDIS_URL=redis://redis:6379/0
USER_STATE_CACHE_TTL_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=300

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=fraud-detection
MODEL_NAME=fraud-xgb
MODEL_ALIAS=production

# API security
API_KEYS=dev-key-123,analyst-key-456
ADMIN_API_KEY=admin-secret-key
RATE_LIMIT_PER_MINUTE=120

# Thresholds (overridden by model artifact metadata at serve time)
THRESHOLD_REVIEW=0.35
THRESHOLD_DECLINE=0.75

# Monitoring
DRIFT_PSI_ALERT=0.25
