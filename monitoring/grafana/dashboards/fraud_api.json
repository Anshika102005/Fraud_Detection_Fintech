{
  "title": "Fraud Detection — Real-Time Service",
  "uid": "fraud-api",
  "timezone": "utc",
  "refresh": "30s",
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Request rate by decision",
     "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(predict_requests_total[5m])) by (decision)", "legendFormat": "{{decision}}"}]},
    {"id": 2, "type": "timeseries", "title": "Latency p50/p95/p99",
     "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "targets": [
       {"expr": "histogram_quantile(0.50, sum(rate(predict_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50"},
       {"expr": "histogram_quantile(0.95, sum(rate(predict_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95"},
       {"expr": "histogram_quantile(0.99, sum(rate(predict_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99"}]},
    {"id": 3, "type": "timeseries", "title": "Score distribution (drift early-warning)",
     "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(predict_score_distribution_bucket[10m])) by (le)", "legendFormat": "{{le}}", "format": "heatmap"}]},
    {"id": 4, "type": "gauge", "title": "Predicted fraud rate (instant)",
     "gridPos": {"x": 12, "y": 8, "w": 6, "h": 8},
     "targets": [{"expr": "fraud_prediction_rate"}],
     "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.3}, {"color": "red", "value": 0.7}]}}}},
    {"id": 5, "type": "table", "title": "Top feature drift (PSI vs training reference)",
     "gridPos": {"x": 18, "y": 8, "w": 6, "h": 8},
     "targets": [{"expr": "fraud_drift_psi", "format": "table", "instant": true}],
     "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true}}}]},
    {"id": 6, "type": "timeseries", "title": "Velocity feature (avg customer_txn_count_1h of logged preds)",
     "gridPos": {"x": 0, "y": 16, "w": 12, "h": 7},
     "targets": [{"expr": "avg_over_time(fraud_prediction_rate[1h])", "legendFormat": "avg fraud rate 1h"}]},
    {"id": 7, "type": "stat", "title": "Model version in serving",
     "gridPos": {"x": 12, "y": 16, "w": 6, "h": 7},
     "targets": [{"expr": 'count(count by (model_version) (predict_requests_total))', "legendFormat": "versions"}]},
    {"id": 8, "type": "timeseries", "title": "CRITICAL/HIGH risk share",
     "gridPos": {"x": 18, "y": 16, "w": 6, "h": 7},
     "targets": [{"expr": "sum(rate(predict_requests_total{risk_level=\"CRITICAL\"}[15m])) / clamp_min(sum(rate(predict_requests_total[15m])), 1e-6)", "legendFormat": "critical"},
                 {"expr": "sum(rate(predict_requests_total{risk_level=\"HIGH\"}[15m])) / clamp_min(sum(rate(predict_requests_total[15m])), 1e-6)", "legendFormat": "high"}]}
  ],
  "schemaVersion": 39,
  "version": 1
}
