# Training image: heavier deps allowed, still pinned + non-root.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY src/ ./src/
COPY mlops/ ./mlops/
COPY configs/ ./configs/
COPY sql/ ./sql/
RUN useradd --system --uid 10001 --shell /usr/sbin/nologin appuser \
    && chown -R appuser:appuser /app
USER appuser

# Default: full train + register to MLflow (overridable via command / env)
CMD ["python", "-m", "src.models.train", "--model", "lightgbm", "--trials", "30", "--register"]
